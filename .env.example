# Kopiraj u .env (ne ide u repo). Lokalno odgovara docker-compose.yml.
DATABASE_URL=postgresql://aitracker:aitracker@localhost:5432/aitracker
# Samo za integracione testove; baza se ne prazni, testovi rade u privremenoj šemi.
TEST_DATABASE_URL=postgresql://aitracker:aitracker@localhost:5432/aitracker
# LLM (SPEC 4, 11). Model se bira blind testom u F3; do tada se postavlja ručno.
LLM_PROVIDER=openrouter
LLM_MODEL=
# Ključ sa https://openrouter.ai/keys; postavi limit potrošnje ključa na 5 USD.
OPENROUTER_API_KEY=
